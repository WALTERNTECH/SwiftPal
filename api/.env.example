# Copy to .env for local runs. Without DATABASE_URL the API uses an in-process Postgres.

NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# postgresql://swiftpal_api.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# 32 bytes as hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=
# Secret segment in Daraja callback URLs (24+ chars). Safaricom signs nothing; this is the gate.
CALLBACK_TOKEN=
# Setup key for the first admin console owner, and Bearer token for /admin scripts.
ADMIN_TOKEN=
# Shared with swiftpal-admin. Browser calls to /admin without it get 404.
ADMIN_GATEWAY_SECRET=

# Email codes and reset links. Without a key they are printed to the log.
# MAIL_FROM must be on a domain verified in Resend; onboarding@resend.dev only reaches your own inbox.
RESEND_API_KEY=
MAIL_FROM=SwiftPal <onboarding@resend.dev>

# SMS codes for sign-up, sign-in and live withdrawals/payouts (Africa's Talking).
# Without these, codes are printed to the log. Username "sandbox" uses the AT simulator.
AT_USERNAME=
AT_API_KEY=
# Optional registered sender ID, e.g. SWIFTPAL. Empty uses Africa's Talking's shared shortcode.
AT_SENDER_ID=

# ID and selfie uploads. Without these, files are stored in the swiftpal.blobs table.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=swiftpal-kyc

# Live M-Pesa (Daraja). Leave empty to run sandbox-only; live requests then return 503 live_not_configured.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
# M-Pesa Express shortcode + passkey: used for wallet top-ups and for channels that aren't linked with their own passkey.
DARAJA_STK_SHORTCODE=
DARAJA_STK_PASSKEY=
# B2C shortcode that holds merchants' payout float, its API initiator, and the
# initiator password encrypted with Safaricom's certificate (the Daraja portal generates it).
DARAJA_B2C_SHORTCODE=
DARAJA_INITIATOR_NAME=
DARAJA_SECURITY_CREDENTIAL=
# Re-read every live success callback with STK Query before trusting it.
DARAJA_CONFIRM_STK=true
