# The SwiftPal API the dashboard proxies to (src/app/backend).
API_URL=http://localhost:4000
# Same value as WEB_PROXY_SECRET on swiftpal-api; lets the API trust the visitor IP this server passes on.
WEB_PROXY_SECRET=
# Render proxies to the right of the visitor in X-Forwarded-For (2 on Render).
PROXY_HOPS=2
# Public addresses shown in docs, snippets and links.
PUBLIC_API_URL=
PUBLIC_WEB_URL=
